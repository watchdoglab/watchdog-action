{
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "not_checked", "findings"],
  "properties": {
    "summary": { "type": "string" },
    "not_checked": { "type": "string" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "title", "path", "line", "body", "suggestion"],
        "properties": {
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
          "title": { "type": "string" },
          "path": { "type": "string" },
          "line": { "type": "integer" },
          "body": { "type": "string" },
          "suggestion": { "type": "string" }
        }
      }
    }
  }
}
